    },
    {
      "id": "function:Assets/Scripts/OpponentDriver.cs:Update",
      "type": "function",
      "name": "Update",
      "filePath": "Assets/Scripts/OpponentDriver.cs",
      "lineRange": [
        49,
        72
      ],
