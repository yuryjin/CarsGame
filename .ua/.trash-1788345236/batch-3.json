    {
      "id": "file:Assets/Scripts/CarCameraFollow.cs",
      "type": "file",
      "name": "CarCameraFollow.cs",
      "filePath": "Assets/Scripts/CarCameraFollow.cs",
      "summary": "Компонент камеры преследования: в LateUpdate плавно подтягивает камеру к смещённой позиции за машиной, поворачивает её на точку перед автомобилем и динамически расширяет поле зрения (FOV) в зависимости от скорости Rigidbody.",
      "tags": [
        "component",
        "камера",
        "monobehaviour",
        "геймплей",
        "smoothing"
      ],
      "complexity": "simple",
      "languageNotes": "Логика вынесена в LateUpdate, чтобы камера обновлялась после перемещения машины в текущем кадре; сглаживание через Vector3.Lerp/Quaternion.Slerp с коэффициентом на Time.deltaTime."
    },
    {
      "id": "class:Assets/Scripts/CarCameraFollow.cs:CarCameraFollow",
      "type": "class",
      "name": "CarCameraFollow",
      "filePath": "Assets/Scripts/CarCameraFollow.cs",
      "lineRange": [
        5,
        45
      ],
      "summary": "MonoBehaviour следования камеры за целевым Transform с настраиваемым смещением, скоростями сглаживания позиции и поворота и множителем FOV от скорости.",
      "tags": [
        "component",
        "камера",
        "monobehaviour",
        "геймплей"
      ],
      "complexity": "simple"
    },
    {
