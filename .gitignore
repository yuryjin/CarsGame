# ---- Unity generated ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore meta files that belong to tracked assets
!/[Aa]ssets/**/*.meta

# ---- Addressables / StreamingAssets ----
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# ---- IDE / editors ----
.vs/
.vscode/
.idea/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Builds / packages ----
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties
sysinfo.txt

# ---- Plastic SCM / Unity Version Control (not used, git is the VCS here) ----
.plastic/
/[Aa]ssets/Plugins/PlasticSCM*
graphify-out
# ---- Unity AI Assistant scratch files (chat image references etc.) ----
/[Aa]ssets/AI Toolkit/
/[Aa]ssets/AI Toolkit.meta
# ---- Editor crash-recovery scenes and stray batch-build output inside Assets ----
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
/[Aa]ssets/CarsGame/Tests/EditMode/Library/
/[Aa]ssets/CarsGame/Tests/EditMode/Library.meta
