      m_Items: []
  - m_Id: 8409662261374976
    m_Localized: Leviathan
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346496
    m_Localized: Boss mission / {n} allies
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346497
    m_Localized: RUST LEVIATHAN
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346498
    m_Localized: '{m} m to the Last Well'
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346499
    m_Localized: 'Enemies: {n}   Your kills: {k}'
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346500
    m_Localized: Stop the fortress before it reaches the Last Well!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346501
    m_Localized: Troopers are coming down the ramps!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346502
    m_Localized: AIR RAID! Get out of the red rings!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346503
    m_Localized: A tank rolls out of the fortress
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346504
    m_Localized: An armoured car joins the escort
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346505
    m_Localized: 'The Leviathan is enraged: troops deploying!'
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346506
    m_Localized: Last stand! The core is overheating!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346507
    m_Localized: Main gun destroyed!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346508
    m_Localized: All main guns silenced!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346509
    m_Localized: Flak turret destroyed!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346510
    m_Localized: Mortar destroyed!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346511
    m_Localized: Drone hangar destroyed!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346512
    m_Localized: Bomber shot down!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346513
    m_Localized: THE LEVIATHAN IS DOWN!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346514
    m_Localized: "The fortress reached the Last Well\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346515
    m_Localized: Destroy the fortress
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346516
    m_Localized: Destroy {n} enemies
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346517
    m_Localized: Tank
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346518
    m_Localized: Armoured car
    m_Metadata:
      m_Items: []
  - m_Id: 8416702429306880
    m_Localized: Auto-aim
    m_Metadata:
      m_Items: []
  - m_Id: 8422648324988928
    m_Localized: RAILS ARE DOWN!
    m_Metadata:
      m_Items: []
  - m_Id: 8422648379514880
    m_Localized: THE ROAD IS COLLAPSING!
    m_Metadata:
      m_Items: []
  - m_Id: 18164871854370816
    m_Localized: Inspect
    m_Metadata:
      m_Items: []
  - m_Id: 18164871858565120
    m_Localized: Drag to rotate
    m_Metadata:
      m_Items: []
  - m_Id: 18164871858565121
    m_Localized: Compared with {name}
    m_Metadata:
      m_Items: []
  - m_Id: 18164871862759424
    m_Localized: "Test drive \xB7 45 s"
    m_Metadata:
      m_Items: []
  - m_Id: 18164871862759425
    m_Localized: Return to garage
    m_Metadata:
      m_Items: []
  - m_Id: 18164871862759426
    m_Localized: Try any body for free. Progress stays unchanged.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466443100160
    m_Localized: Race loadout
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488768
    m_Localized: "Free arsenal \xB7 all weapons"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488769
    m_Localized: "Race loadout \xB7 two weapons"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488770
    m_Localized: SWAP
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488771
    m_Localized: 'Select two weapons. Swap: Q / wheel, gamepad D-pad up/down, or
      SWAP on touch. Secondary equipment below.'
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488772
    m_Localized: "Base damage: {damage} \xB7 interval: {interval} s"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488773
    m_Localized: Ranged fire. Lead moving targets; watch ammo and heat.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488774
    m_Localized: Close combat. Pull alongside a rival before striking.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488775
    m_Localized: Keep one rival in sight. Release fire to cool down.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488776
    m_Localized: Hits rivals in front. Best when the pack bunches up.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488777
    m_Localized: Affects nearby rivals around the car. Get close first.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488778
    m_Localized: Drop behind the car to catch pursuers. Plan your line.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488779
    m_Localized: 'Gas: W/up. Steer: A/D or arrows. Fire: Ctrl / left mouse. Catch
      and hit the rival ahead.'
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488780
    m_Localized: The car accelerates itself. Steer with the arrows; catch a rival
      and press FIRE.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488781
    m_Localized: 'Above 40 km/h: turn and press Space to drift. Build charge, then
      release Space for a boost.'
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488782
    m_Localized: 'Above 40 km/h: steer and tap BRAKE, then hold it to charge. Release
      BRAKE for a boost.'
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488783
    m_Localized: Follow the yellow arrows onto the narrow bridge. A shorter route,
      but no barriers!
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488784
    m_Localized: Enter above 55 km/h. Turn toward the wall early, keep turning onto
      the ceiling, then aim for the gold boost strip.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488785
    m_Localized: Drift boost earned! Try a longer charge on the next bend.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488786
    m_Localized: Shortcut completed! Compare your next lap using the main road.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488787
    m_Localized: Ceiling boost reached! Keep steering smoothly through the tunnel.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488788
    m_Localized: Have the bomb? Touch a rival to pass it. Otherwise keep away from
      the carrier. The fuse keeps ticking.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488789
    m_Localized: Only mines in this race. Get ahead and drop a trap in a pursuer's
      path.
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488790
    m_Localized: Hold brake + steer to charge
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488791
    m_Localized: "Stage {n} \xB7 release brake for boost"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488792
    m_Localized: "Drift boost \xB7 stage {n}"
    m_Metadata:
      m_Items: []
