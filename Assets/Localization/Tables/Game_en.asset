  - m_Id: 8008383424966656
    m_Localized: 18 s fuse. Touch to pass. Timer never resets.
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966657
    m_Localized: 'BOMB ON YOU: {n} s'
    m_Metadata:
      m_Items: []
