    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860364
    m_Localized: "Los objetos amarillos recargan tu ca\xF1\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860365
    m_Localized: "Los objetos azules dan un aceler\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860366
    m_Localized: "\xA1R\xE9cord establecido!"
    m_Metadata:
      m_Items: []
