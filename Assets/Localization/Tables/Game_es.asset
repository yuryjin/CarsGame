  - m_Id: 8008383412383744
    m_Localized: Bomba caliente
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966656
    m_Localized: Mecha de 18 s. Toca para pasarla. El tiempo no se reinicia.
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966657
    m_Localized: 'TIENES LA BOMBA: {n} s'
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966658
    m_Localized: '{name} tiene la bomba: {n} s'
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966659
    m_Localized: Siguiente bomba...
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966660
    m_Localized: "\xA1Toca otro coche para pasarla!"
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966661
    m_Localized: "\xA1Al\xE9jate del coche con la bomba!"
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966662
    m_Localized: "Podr\xE1s pasarla en {n} s"
    m_Metadata:
      m_Items: []
  - m_Id: 8017799678697472
    m_Localized: "M\xFAsica"
    m_Metadata:
      m_Items: []
  - m_Id: 8017799678697473
    m_Localized: "\xBFAtascado? Pulsa R"
    m_Metadata:
      m_Items: []
  - m_Id: 8017799678697474
    m_Localized: "Gira el tel\xE9fono"
