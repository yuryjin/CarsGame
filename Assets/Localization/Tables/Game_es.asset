    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860360
    m_Localized: "\xA1Te disparan! Mu\xE9vete y devuelve el fuego"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860361
    m_Localized: 'Objetivo fijado: dispara con Ctrl o clic izq.'
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860362
