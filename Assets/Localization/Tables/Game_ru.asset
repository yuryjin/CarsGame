  - m_Id: 4010094622
    m_Localized: "\u0424\u0418\u041D\u0418\u0428"
    m_Metadata:
      m_Items: []
  - m_Id: 4010094623
    m_Localized: "\u0413\u0430\u0437: W \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0430
      \u0432\u0432\u0435\u0440\u0445    \u0420\u0443\u043B\u044C: A/D \u0438\u043B\u0438
      \u0441\u0442\u0440\u0435\u043B\u043A\u0438\n\u0422\u043E\u0440\u043C\u043E\u0437:
      \u041F\u0440\u043E\u0431\u0435\u043B    \u041E\u0433\u043E\u043D\u044C: Ctrl
      \u0438\u043B\u0438 \u041B\u041A\u041C\n\u0421\u0431\u0440\u043E\u0441 \u043D\u0430
      \u0442\u0440\u0430\u0441\u0441\u0443: R    \u041F\u0430\u0443\u0437\u0430:
      Esc"
    m_Metadata:
      m_Items: []
  - m_Id: 4010094624
    m_Localized: "\u0420\u0443\u043B\u044C \u2014 \u0441\u0442\u0440\u0435\u043B\u043A\u0438
      \u0441\u043B\u0435\u0432\u0430, \u041E\u0413\u041E\u041D\u042C \u0438 \u0422\u041E\u0420\u041C\u041E\u0417
      \u0441\u043F\u0440\u0430\u0432\u0430. \u041C\u0430\u0448\u0438\u043D\u0430
      \u0435\u0434\u0435\u0442 \u0441\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4010094625
    m_Localized: "\u041F\u0410\u0423\u0417\u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 4010094626
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
