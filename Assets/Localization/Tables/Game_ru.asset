    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456582
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C +10%, \u0440\u0430\u0437\u0433\u043E\u043D
      +8%; HP -15%, \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435 -5%. \u041F\u0443\u0448\u043A\u0430
      + \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456583
    m_Localized: "HP +30%; \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C -6%,
