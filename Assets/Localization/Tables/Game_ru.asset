    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099618
    m_Localized: "\u0412\u0430\u0441 \u0440\u0430\u0437\u0431\u0438\u043B {name}"
    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099653
    m_Localized: "\u0413\u0440\u0430\u0444\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099654
    m_Localized: "\u0410\u0432\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099655
    m_Localized: "\u041D\u0438\u0437\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099656
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099657
    m_Localized: "\u0422\u0440\u044F\u0441\u043A\u0430 \u043A\u0430\u043C\u0435\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099667
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451
      \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 5803307084099668
    m_Localized: "\u0411\u043E\u0435\u0437\u0430\u043F\u0430\u0441 {cur}/{max}"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528248500224
    m_Localized: "\u2605 {s}/{max}"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860352
    m_Localized: "\u0422\u043E\u043F-3 \u043D\u0430 \u0444\u0438\u043D\u0438\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860353
    m_Localized: "\u0420\u0430\u0437\u0431\u0435\u0439\u0442\u0435 2 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860354
    m_Localized: "\u0411\u0435\u0437 \u0430\u0432\u0430\u0440\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860355
    m_Localized: "\u0417\u0412\u0401\u0417\u0414\u042B"
    m_Metadata:
      m_Items: []
