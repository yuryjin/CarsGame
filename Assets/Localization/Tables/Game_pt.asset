  - m_Id: 7347528277860357
    m_Localized: "MUNI\xC7\xC3O RECARREGADA"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860358
    m_Localized: NITRO!
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860359
    m_Localized: "A grama te freia \u2014 fique no asfalto"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860360
    m_Localized: "Voc\xEA est\xE1 sob fogo! Mexa-se e revide"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860361
    m_Localized: "Alvo travado \u2014 atire com Ctrl ou bot\xE3o esq."
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860362
    m_Localized: "Alvo travado \u2014 toque em ATIRAR"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860363
    m_Localized: Itens verdes consertam seu carro
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860364
    m_Localized: "Itens amarelos recarregam seu canh\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860365
    m_Localized: "Itens azuis d\xE3o um impulso de velocidade"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860366
    m_Localized: Recorde definido!
    m_Metadata:
      m_Items: []
  - m_Id: 7347528282054656
    m_Localized: "Novo recorde! \u2212{t} s"
    m_Metadata:
      m_Items: []
