    m_Metadata:
      m_Items: []
  - m_Id: 7658824718262274
    m_Localized: "Sobreviv\xEAncia"
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456576
    m_Localized: Poder de fogo
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456577
    m_Localized: Nenhuma
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456578
    m_Localized: "Usar canh\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456579
    m_Localized: 'Equipado: {primary} / {secondary}'
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456580
    m_Localized: Apenas armas compradas. Troca gratuita.
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456581
    m_Localized: "Valores normais. Canh\xE3o; sem secund\xE1ria."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456582
    m_Localized: "Velocidade +10%, acelera\xE7\xE3o +8%; vida -15%, ader\xEAncia
      -5%. Canh\xE3o + gelo."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456583
    m_Localized: "Vida +30%; velocidade -6%, acelera\xE7\xE3o -10%. Canh\xE3o + minas."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456584
    m_Localized: Dano principal +20%, intervalo -10%; vida -10%, velocidade -3%.
      Metralhadora + minas.
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456585
    m_Localized: Termine entre os {n} primeiros
    m_Metadata:
      m_Items: []
