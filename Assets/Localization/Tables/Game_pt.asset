  - m_Id: 8006398785171456
    m_Localized: CARROCERIA
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754368
    m_Localized: Buggy
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754369
    m_Localized: Esportivo
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754370
    m_Localized: Blindado
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754371
    m_Localized: Tanque
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754372
    m_Localized: "Leve e r\xE1pido na largada, corta pela grama. Fr\xE1gil: evite
      contato, desvie e drifte."
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754373
    m_Localized: "O vers\xE1til: velocidade, ader\xEAncia e blindagem equilibradas.
      Mantenha a linha e lute quando valer a pena."
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754374
    m_Localized: "Pesado e resistente, vence qualquer empurr\xE3o. Freia devagar:
      reduza cedo e depois abalroe."
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754375
    m_Localized: "Lento no asfalto, mas as esteiras quase n\xE3o perdem velocidade
      na grama. Blindagem enorme; a torre gira o dobro."
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754376
    m_Localized: Velocidade
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754377
