  - m_Id: 18182514304954383
    m_Localized: "{effect}: {seconds} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 18240820457320448
    m_Localized: "\u0413\u0430\u0437: W / \u0432\u0433\u043E\u0440\u0443. \u041D\u0430\u0437\u0430\u0434:
      S / \u0432\u043D\u0438\u0437. \u041A\u0435\u0440\u043C\u043E: A/D \u0430\u0431\u043E
      \u0441\u0442\u0440\u0456\u043B\u043A\u0438. \u0413\u0430\u043B\u044C\u043C\u043E:
      \u041F\u0440\u043E\u0431\u0456\u043B. \u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
      \u043D\u0430 \u0442\u0440\u0430\u0441\u0443: R."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097664
    m_Localized: "\u041C\u0430\u0448\u0438\u043D\u0430 \u0440\u043E\u0437\u0433\u0430\u043D\u044F\u0454\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0430. \u041A\u0435\u0440\u0443\u0439 \u0441\u0442\u0440\u0456\u043B\u043A\u0430\u043C\u0438.
      \u0423\u0442\u0440\u0438\u043C\u0443\u0439 \xAB\u0413\u0410\u041B\u042C\u041C\u041E\xBB,
      \u0449\u043E\u0431 \u0441\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438\u0441\u044F.
      \u041A\u043D\u043E\u043F\u043A\u0430 R \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454
      \u043D\u0430 \u0442\u0440\u0430\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097665
    m_Localized: "\u0412\u043E\u0433\u043E\u043D\u044C: Ctrl / \u041B\u041A\u041C.
      \u0417\u043C\u0456\u043D\u0430 \u0434\u0432\u043E\u0445 \u0432\u0438\u0431\u0440\u0430\u043D\u0438\u0445
      \u0432\u0438\u0434\u0456\u0432 \u0437\u0431\u0440\u043E\u0457: Q / \u043A\u043E\u043B\u0456\u0449\u0430\u0442\u043A\u043E
      \u0430\u0431\u043E \u043A\u043B\u0430\u0432\u0456\u0448\u0456 1 \u0456 2."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097666
    m_Localized: "\u0412\u043E\u0433\u043E\u043D\u044C: Ctrl / \u041B\u041A\u041C.
      \u0423\u0442\u0440\u0438\u043C\u0443\u0439 Q \u0456 \u0440\u0443\u0445\u0430\u0439
      \u043C\u0438\u0448\u0435\u044E \u0434\u043B\u044F \u0432\u0438\u0431\u043E\u0440\u0443
      \u0437\u0431\u0440\u043E\u0457; \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u0438
      Q \u0434\u043B\u044F \u0437\u043C\u0456\u043D\u0438. \u0417 \u0443\u0442\u0440\u0438\u043C\u0430\u043D\u043E\u044E
      Q: Tab / \u043A\u043E\u043B\u0456\u0449\u0430\u0442\u043A\u043E \u0437\u043C\u0456\u043D\u044E\u044E\u0442\u044C
      \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0443, 1\u20130 \u0432\u0438\u0431\u0438\u0440\u0430\u044E\u0442\u044C
      \u0441\u043B\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097667
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439 \xAB\u0412\u041E\u0413\u041E\u041D\u042C\xBB,
      \u0449\u043E\u0431 \u0441\u0442\u0440\u0456\u043B\u044F\u0442\u0438. \xAB\u0417\u041C\u0406\u041D\u0418\u0422\u0418\xBB
      \u043F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u0454 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0443
      \u0437\u0431\u0440\u043E\u044E \u0443 \u0442\u0432\u043E\u0454\u043C\u0443
      \u043D\u0430\u0431\u043E\u0440\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097668
    m_Localized: "{action}: E / Shift / \u041F\u041A\u041C / LB. \u0411\u043E\u0454\u0437\u0430\u043F\u0430\u0441
      \u0456 \u0433\u043E\u0442\u043E\u0432\u043D\u0456\u0441\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0456
      \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097669
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0438 \xAB{action}\xBB, \u0449\u043E\u0431
      \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443
      \u0437\u0431\u0440\u043E\u044E. \u0411\u043E\u0454\u0437\u0430\u043F\u0430\u0441
      \u0456 \u0433\u043E\u0442\u043E\u0432\u043D\u0456\u0441\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0456
      \u043D\u0430 \u0435\u043A\u0440\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097670
    m_Localized: "\u042F\u043A\u0449\u043E \u0437\u0430\u0440\u044F\u0434 \u0443\u0436\u0435
      \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E, \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      \u0442\u0443 \u0441\u0430\u043C\u0443 \u043A\u043D\u043E\u043F\u043A\u0443
      \u0449\u0435 \u0440\u0430\u0437 \u0434\u043B\u044F \u0432\u0438\u0431\u0443\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097671
    m_Localized: "\u0413\u0435\u0439\u043C\u043F\u0430\u0434: \u043B\u0456\u0432\u0438\u0439
      \u0441\u0442\u0456\u043A \u2014 \u043A\u0435\u0440\u043C\u043E; RT / LT \u2014
      \u0433\u0430\u0437 / \u043D\u0430\u0437\u0430\u0434; A \u2014 \u0433\u0430\u043B\u044C\u043C\u043E;
      Y \u2014 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u043D\u0430
      \u0442\u0440\u0430\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820478291968
    m_Localized: "\u0413\u0435\u0439\u043C\u043F\u0430\u0434: RB \u2014 \u0432\u043E\u0433\u043E\u043D\u044C;
      \u0432\u043D\u0438\u0437 / \u0432\u0433\u043E\u0440\u0443 \u043D\u0430 \u0445\u0440\u0435\u0441\u0442\u043E\u0432\u0438\u043D\u0456
      \u2014 \u0441\u043B\u043E\u0442\u0438 \u0437\u0431\u0440\u043E\u0457 1 / 2."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820478291969
    m_Localized: "\u041B\u0438\u0448\u0435 \u043C\u0456\u043D\u0438. \u0412\u0438\u0440\u0432\u0438\u0441\u044C
      \u0443\u043F\u0435\u0440\u0435\u0434 \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      E / Shift / \u041F\u041A\u041C, \u0449\u043E\u0431 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438
      \u043C\u0456\u043D\u0443 \u043F\u043E\u0437\u0430\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820478291970
    m_Localized: "\u041B\u0438\u0448\u0435 \u043C\u0456\u043D\u0438. \u0412\u0438\u0440\u0432\u0438\u0441\u044C
      \u0443\u043F\u0435\u0440\u0435\u0434 \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0438
      \xAB\u041C\u0406\u041D\u0410\xBB, \u0449\u043E\u0431 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438
      \u043F\u0430\u0441\u0442\u043A\u0443 \u043F\u0435\u0440\u0435\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u0447\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 18675088652316672
    m_Localized: "\u0426\u0415\u0419 \u0417\u0410\u0407\u0417\u0414: {n}/3 \u0417\u0406\u0420\u041A\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 18675088660705280
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u043D\u0430 \u0432 \u0446\u044C\u043E\u043C\u0443
      \u0437\u0430\u0457\u0437\u0434\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 18675088660705281
    m_Localized: "\u041E\u0442\u0440\u0438\u043C\u0430\u043D\u0430 \u0440\u0430\u043D\u0456\u0448\u0435
      \xB7 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18675088660705282
    m_Localized: "\u041D\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0430 \u0432
      \u0446\u044C\u043E\u043C\u0443 \u0437\u0430\u0457\u0437\u0434\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 18826098154745856
    m_Localized: "\u0422\u0440\u0430\u0441\u0430 \u0437\u043C\u0456\u043D\u044E\u0454\u0442\u044C\u0441\u044F:
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u043A\u043E\u043B\u0456
      \u0437\u043D\u0438\u043A\u043D\u0443\u0442\u044C \u043E\u0433\u043E\u0440\u043E\u0436\u0456,
      \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u043E\u043C\u0443 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0437\u0432\u0443\u0437\u0438\u0442\u044C\u0441\u044F. \u0422\u0440\u0438\u043C\u0430\u0439\u0441\u044F
      \u0431\u043B\u0438\u0436\u0447\u0435 \u0434\u043E \u0446\u0435\u043D\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18826098205077504
    m_Localized: "\u041F\u0440\u043E\u0457\u0436\u0434\u0436\u0430\u0439 \u043A\u0440\u0456\u0437\u044C
      \u0441\u044F\u044E\u0447\u0456 \u043A\u0456\u043B\u044C\u0446\u044F \u0434\u043B\u044F
      \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u044F. \u041E\u0433\u043E\u0440\u043E\u0436
      \u043D\u0435\u043C\u0430\u0454: \u0432\u0438\u0440\u0456\u0432\u043D\u044F\u0439
      \u043C\u0430\u0448\u0438\u043D\u0443 \u043F\u0435\u0440\u0435\u0434 \u0440\u043E\u0437\u0433\u043E\u043D\u043E\u043C."
    m_Metadata:
