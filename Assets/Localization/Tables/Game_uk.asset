  - m_Id: 8006398797754371
    m_Localized: "\u0422\u0430\u043D\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754372
    m_Localized: "\u041B\u0435\u0433\u043A\u0438\u0439 \u0456 \u0436\u0432\u0430\u0432\u0438\u0439
      \u0437\u0456 \u0441\u0442\u0430\u0440\u0442\u0443, \u0437\u0440\u0456\u0437\u0430\u0454
      \u043F\u043E \u0442\u0440\u0430\u0432\u0456. \u041A\u0440\u0438\u0445\u043A\u0438\u0439:
      \u0443\u043D\u0438\u043A\u0430\u0439 \u043F\u043E\u0448\u0442\u043E\u0432\u0445\u0456\u0432,
      \u0443\u0445\u0438\u043B\u044F\u0439\u0441\u044F \u0456 \u0434\u0440\u0438\u0444\u0442\u0443\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754373
    m_Localized: "\u0423\u043D\u0456\u0432\u0435\u0440\u0441\u0430\u043B: \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C,
      \u0437\u0447\u0435\u043F\u043B\u0435\u043D\u043D\u044F \u0456 \u0431\u0440\u043E\u043D\u044F
      \u0432 \u0431\u0430\u043B\u0430\u043D\u0441\u0456. \u0422\u0440\u0438\u043C\u0430\u0439
      \u0442\u0440\u0430\u0454\u043A\u0442\u043E\u0440\u0456\u044E \u0456 \u0431\u0438\u0439\u0441\u044F,
      \u043A\u043E\u043B\u0438 \u0432\u0438\u0433\u0456\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754374
    m_Localized: "\u0412\u0430\u0436\u043A\u0438\u0439 \u0456 \u043C\u0456\u0446\u043D\u0438\u0439,
      \u043F\u0435\u0440\u0435\u043C\u0430\u0433\u0430\u0454 \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456\u0439
      \u0448\u0442\u043E\u0432\u0445\u0430\u043D\u0438\u043D\u0456. \u0414\u043E\u0432\u0433\u043E
      \u0433\u0430\u043B\u044C\u043C\u0443\u0454: \u0441\u043A\u0438\u0434\u0430\u0439
      \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C \u0437\u0430\u0437\u0434\u0430\u043B\u0435\u0433\u0456\u0434\u044C,
      \u043F\u043E\u0442\u0456\u043C \u0442\u0430\u0440\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 8006398797754375
    m_Localized: "\u041F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0439 \u043D\u0430
      \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0456, \u0430\u043B\u0435 \u043D\u0430
      \u0433\u0443\u0441\u0435\u043D\u0438\u0446\u044F\u0445 \u043C\u0430\u0439\u0436\u0435
      \u043D\u0435 \u0432\u0442\u0440\u0430\u0447\u0430\u0454 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u043D\u0430 \u0442\u0440\u0430\u0432\u0456. \u041F\u043E\u0442\u0443\u0436\u043D\u0430
      \u0431\u0440\u043E\u043D\u044F, \u0431\u0430\u0448\u0442\u0430 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u0434\u0432\u0456\u0447\u0456 \u0448\u0438\u0440\u0448\u0435."
    m_Metadata:
      m_Items: []
