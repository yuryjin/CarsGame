    m_Localized: "\u0411\u043E\u043D\u0443\u0441 \u0437\u0430 \u0440\u0435\u043A\u043B\u0430\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653597024258
    m_Localized: "\u0423\u0441\u044C\u043E\u0433\u043E \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 19041856738635776
    m_Localized: "\u0413\u0410\u0417\n\u043D\u0430 \xAB\u0421\u0422\u0410\u0420\u0422!\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 19052585529192448
    m_Localized: "\u0406\u0434\u0435\u0430\u043B\u044C\u043D\u0438\u0439 \u0441\u0442\u0430\u0440\u0442:
      \u043D\u0430\u0442\u0438\u0441\u043D\u0438 \u0433\u0430\u0437 \u043D\u0430
      \xAB\u0421\u0422\u0410\u0420\u0422!\xBB, \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043A\u043E\u0440\u043E\u0442\u043A\u0435 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u044F.
      \u0417\u0430\u0432\u0447\u0430\u0441\u043D\u0435 \u0443\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F
      \u0433\u0430\u0437\u0443 \u0439 \u0430\u0432\u0442\u043E\u0433\u0430\u0437
      \u043D\u0435 \u0434\u0430\u044E\u0442\u044C \u0431\u043E\u043D\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 19055832478330880
    m_Localized: "\u0417\u0443\u043C \u0456 \u043D\u0430\u0445\u0438\u043B \u043A\u0430\u043C\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 19066674489929728
    m_Localized: "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438
      \u043C\u043E\u0432\u0443. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435
      \u0437\u2019\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u0439 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044C
      \u0457\u0457 \u0449\u0435 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 19075158564483072
    m_Localized: "\u041F\u0440\u043E\u0433\u0440\u0435\u0441 \u043D\u0435 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u043D\u0430 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871680
    m_Localized: "\u041F\u0440\u043E\u0433\u0440\u0435\u0441 \u043F\u043E\u043A\u0438
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F \u0432
      \u043F\u0430\u043C\u2019\u044F\u0442\u0456. \u0417\u0432\u0456\u043B\u044C\u043D\u0456\u0442\u044C
      \u043C\u0456\u0441\u0446\u0435 \u0430\u0431\u043E \u0434\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043D\u043D\u044F \u0434\u0430\u043D\u0438\u0445
      \u0443 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0456 \u0439 \u043F\u043E\u0432\u0442\u043E\u0440\u0456\u0442\u044C
      \u0437\u0430\u043F\u0438\u0441. \u041F\u0456\u0441\u043B\u044F \u0437\u0430\u043A\u0440\u0438\u0442\u0442\u044F
      \u0433\u0440\u0438 \u043D\u0435\u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0439
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441 \u043C\u043E\u0436\u0435 \u0437\u043D\u0438\u043A\u043D\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871681
    m_Localized: "\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0438 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871682
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0431\u0435\u0437
      \u0437\u0430\u043F\u0438\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871683
    m_Localized: "\u041F\u0440\u043E\u0433\u0440\u0435\u0441 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u043D\u0430 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871684
    m_Localized: "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871685
    m_Localized: "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u0438
      \u0434\u0430\u043D\u0456. \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0439
      \u043F\u0440\u043E\u0444\u0456\u043B\u044C \u043D\u0435 \u0437\u0430\u043C\u0456\u043D\u0435\u043D\u043E.
      \u0414\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u043D\u043D\u044F
      \u0434\u0430\u043D\u0438\u0445 \u0443 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0456
