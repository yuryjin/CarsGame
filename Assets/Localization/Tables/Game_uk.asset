      \u0437\u0431\u0440\u043E\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456582
    m_Localized: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C +10%, \u0440\u043E\u0437\u0433\u0456\u043D
      +8%; HP -15%, \u0437\u0447\u0435\u043F\u043B\u0435\u043D\u043D\u044F -5%. \u0413\u0430\u0440\u043C\u0430\u0442\u0430
      + \u0437\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430."
    m_Metadata:
      m_Items: []
