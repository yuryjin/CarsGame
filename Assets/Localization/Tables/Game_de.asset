    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860359
    m_Localized: "Gras bremst \u2014 bleib auf dem Asphalt"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860360
    m_Localized: "Du wirst beschossen! Bleib in Bewegung, schie\xDF zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860361
    m_Localized: "Ziel erfasst \u2014 Feuer: Strg oder LMT"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860362
    m_Localized: "Ziel erfasst \u2014 tippe auf FEUER"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860363
    m_Localized: "Gr\xFCne Pickups reparieren dein Auto"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860364
