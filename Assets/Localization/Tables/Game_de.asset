  - m_Id: 8008383424966656
    m_Localized: "18 s Z\xFCnder. Durch Ber\xFChrung weitergeben. Zeit l\xE4uft weiter."
    m_Metadata:
      m_Items: []
  - m_Id: 8008383424966657
    m_Localized: 'BOMBE BEI DIR: {n} s'
    m_Metadata:
      m_Items: []
