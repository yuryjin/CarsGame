    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860361
    m_Localized: "Cible verrouill\xE9e : tir avec Ctrl ou clic gauche"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860362
