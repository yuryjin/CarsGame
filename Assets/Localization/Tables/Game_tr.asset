    m_Metadata:
      m_Items: []
  - m_Id: 7651194763386888
    m_Localized: "Makineli T\xFCfek"
    m_Metadata:
      m_Items: []
  - m_Id: 7651194763386889
    m_Localized: "A\u015F\u0131r\u0131 \u0131s\u0131nabilen seri birincil silah"
