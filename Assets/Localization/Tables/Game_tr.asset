      m_Items: []
  - m_Id: 7347528277860360
    m_Localized: "Ate\u015F alt\u0131ndas\u0131n! Hareket et, kar\u015F\u0131l\u0131k
      ver"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860361
    m_Localized: "Hedef kilitli \u2014 ate\u015F: Ctrl veya sol t\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 7347528277860362
