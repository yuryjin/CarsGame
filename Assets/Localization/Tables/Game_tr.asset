  - m_Id: 8409662282346496
    m_Localized: "Boss g\xF6revi / {n} m\xFCttefik"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346497
    m_Localized: "PAS LEV\u0130ATAN"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346498
    m_Localized: Son Kuyu'ya {m} m
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346499
    m_Localized: "D\xFC\u015Fman: {n}   Le\u015Flerin: {k}"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346500
    m_Localized: Kale Son Kuyu'ya varmadan onu durdur!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346501
    m_Localized: Siborglar rampalardan iniyor!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346502
    m_Localized: "HAVA SALDIRISI! K\u0131rm\u0131z\u0131 halkalardan \xE7\u0131k!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346503
    m_Localized: "Kaleden bir tank \xE7\u0131kt\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346504
    m_Localized: "Eskorta bir z\u0131rhl\u0131 ara\xE7 kat\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346505
    m_Localized: "Leviatan \xF6fkeli: asker iniyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346506
    m_Localized: "Son direni\u015F! \xC7ekirdek a\u015F\u0131r\u0131 \u0131s\u0131n\u0131yor!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346507
    m_Localized: Ana top yok edildi!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346508
    m_Localized: "T\xFCm toplar susturuldu!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346509
    m_Localized: "U\xE7aksavar yok edildi!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346510
    m_Localized: Havan yok edildi!
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346511
    m_Localized: "Drone hangar\u0131 yok edildi!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346512
    m_Localized: "Bombard\u0131man u\xE7a\u011F\u0131 d\xFC\u015F\xFCr\xFCld\xFC!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346513
    m_Localized: "LEV\u0130ATAN D\xDC\u015ET\xDC!"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346514
    m_Localized: "Kale Son Kuyu'ya ula\u015Ft\u0131\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346515
    m_Localized: Kaleyi yok et
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346516
    m_Localized: "{n} d\xFC\u015Fman yok et"
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346517
    m_Localized: Tank
    m_Metadata:
      m_Items: []
  - m_Id: 8409662282346518
    m_Localized: "Z\u0131rhl\u0131 ara\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 8416702429306880
    m_Localized: "Otomatik ni\u015Fan"
    m_Metadata:
      m_Items: []
  - m_Id: 8422648324988928
    m_Localized: "BAR\u0130YERLER \u0130ND\u0130!"
    m_Metadata:
      m_Items: []
  - m_Id: 8422648379514880
    m_Localized: "YOL \xC7\xD6K\xDCYOR!"
    m_Metadata:
      m_Items: []
  - m_Id: 18164871854370816
    m_Localized: "\u0130ncele"
    m_Metadata:
      m_Items: []
  - m_Id: 18164871858565120
    m_Localized: "D\xF6nd\xFCrmek i\xE7in s\xFCr\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 18164871858565121
    m_Localized: "{name} ile kar\u015F\u0131la\u015Ft\u0131rma"
    m_Metadata:
      m_Items: []
  - m_Id: 18164871862759424
    m_Localized: "Test s\xFCr\xFC\u015F\xFC \xB7 45 sn"
    m_Metadata:
      m_Items: []
  - m_Id: 18164871862759425
    m_Localized: "Garaja d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 18164871862759426
    m_Localized: "Her g\xF6vdeyi \xFCcretsiz dene. \u0130lerleme de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466443100160
    m_Localized: "Yar\u0131\u015F donan\u0131m\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488768
    m_Localized: "Serbest cephanelik \xB7 t\xFCm silahlar"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488769
    m_Localized: "Yar\u0131\u015F donan\u0131m\u0131 \xB7 iki silah"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488770
    m_Localized: "DE\u011E\u0130\u015ET\u0130R"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488771
    m_Localized: "\u0130ki silah se\xE7. Q / tekerlek, y\xF6n tu\u015Fu yukar\u0131/a\u015Fa\u011F\u0131
      veya DE\u011E\u0130\u015ET\u0130R ile ge\xE7i\u015F yap. \u0130kincil silahlar
      a\u015Fa\u011F\u0131da."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488772
    m_Localized: "Temel hasar: {damage} \xB7 aral\u0131k: {interval} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488773
    m_Localized: "Uzaktan ate\u015F. Hareketli hedeflerin \xF6n\xFCne ni\u015Fan
      al; cephane ve \u0131s\u0131y\u0131 izle."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488774
    m_Localized: "Yak\u0131n d\xF6v\xFC\u015F. Vurmadan \xF6nce rakibin yan\u0131na
      gel."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488775
    m_Localized: "Bir rakibi g\xF6r\xFC\u015Fte tut. So\u011Fumak i\xE7in ate\u015Fi
      b\u0131rak."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488776
    m_Localized: "\xD6ndeki rakipleri vurur. S\u0131k\u0131\u015F\u0131k gruplara
      kar\u015F\u0131 etkilidir."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488777
    m_Localized: "Arac\u0131n \xE7evresindeki rakipleri etkiler. \xD6nce yakla\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488778
    m_Localized: "Takip\xE7ileri yakalamak i\xE7in arkaya b\u0131rak. Rotan\u0131
      planla."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488779
    m_Localized: "Gaz: {bind.gas}. D\xF6n: {bind.steer}. Ate\u015F: {bind.fire} /
      sol fare. \xD6ndeki rakibi yakala ve vur."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488780
    m_Localized: "Ara\xE7 kendisi h\u0131zlan\u0131r. Oklarla d\xF6n; rakibi yakala
      ve ATE\u015E'e bas."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488781
    m_Localized: "40 km/sa \xFCzerinde d\xF6n ve {bind.brake} tu\u015Funa bas. \u015Earj
      biriktir, h\u0131zlanmak i\xE7in tu\u015Fu b\u0131rak."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488782
    m_Localized: "40 km/sa \xFCzerinde d\xF6n ve FREN'e bas\u0131l\u0131 tut. H\u0131zlanmak
      i\xE7in FREN'i b\u0131rak."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488783
    m_Localized: "Sar\u0131 oklarla dar k\xF6pr\xFCye gir. Daha k\u0131sa yol, ama
      bariyer yok!"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488784
    m_Localized: "55 km/sa \xFCzerinde gir. Duvara erken d\xF6n, tavana \xE7\u0131kana
      kadar d\xF6nmeye devam et, sonra alt\u0131n h\u0131zland\u0131r\u0131c\u0131
      \u015Feride y\xF6nel."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488785
    m_Localized: "Drift h\u0131zlanmas\u0131 kazan\u0131ld\u0131! Sonraki virajda
      daha \xE7ok \u015Farj biriktir."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488786
    m_Localized: "Kestirme tamamland\u0131! Sonraki turda ana yolla kar\u015F\u0131la\u015Ft\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488787
    m_Localized: "Tavan h\u0131zland\u0131r\u0131c\u0131s\u0131na ula\u015Ft\u0131n!
      T\xFCnelde yumu\u015Fak d\xF6nmeye devam et."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488788
    m_Localized: "Bomba sende mi? Aktarmak i\xE7in rakibe dokun. De\u011Filse ta\u015F\u0131y\u0131c\u0131dan
      uzak dur. Fitil s\u0131f\u0131rlanmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488789
    m_Localized: "Bu yar\u0131\u015Fta sadece may\u0131n var. \xD6ne ge\xE7 ve takip\xE7inin
      yoluna tuzak b\u0131rak."
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488790
    m_Localized: "\u015Earj i\xE7in fren ve y\xF6n\xFC tut"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488791
    m_Localized: "Seviye {n} \xB7 h\u0131zlanmak i\xE7in freni b\u0131rak"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488792
    m_Localized: "Drift h\u0131zlanmas\u0131 \xB7 seviye {n}"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488793
    m_Localized: "\u2605 {n}/3 \xB7 Hedefleri g\xF6ster"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488794
    m_Localized: "Par\xE7alanmadan veya s\u0131f\u0131rlamadan bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488795
    m_Localized: "{n} drift h\u0131zlanmas\u0131 kazan"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488796
    m_Localized: "K\xF6pr\xFC kestirmesini {n} kez tamamla"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488797
    m_Localized: "Tavan h\u0131zland\u0131r\u0131c\u0131s\u0131n\u0131 kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488798
    m_Localized: "Son turu kaza veya s\u0131f\u0131rlama olmadan bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488799
    m_Localized: "Bombay\u0131 {n} kez aktar"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488800
    m_Localized: "Yar\u0131\u015F kupalar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488801
    m_Localized: "S\xFCr\xFC\u015F okulu"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488802
    m_Localized: "Sava\u015F kupas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488803
    m_Localized: Ekstrem rotalar
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488804
    m_Localized: "\u2605 {stars}/6 \xB7 {n}/3 yar\u0131\u015F tamamland\u0131 \xB7
      \xD6d\xFCl: {reward}"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488805
    m_Localized: "\xD6d\xFCl a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488806
    m_Localized: Sonraki hedefin
    m_Metadata:
      m_Items: []
  - m_Id: 18165466451488807
    m_Localized: "Ki\u015Fisel rekorunu k\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 18166440566009856
    m_Localized: Kontroller ve hedefler
    m_Metadata:
      m_Items: []
  - m_Id: 18182514288177152
    m_Localized: "T\xFCm\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954368
    m_Localized: Menzilli
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954369
    m_Localized: "Yak\u0131n d\xF6v\xFC\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954370
    m_Localized: Kontrol
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954371
    m_Localized: Tuzaklar
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954372
    m_Localized: "Geni\u015F sa\xE7\u0131lma. Daha \xE7ok sa\xE7ma isabeti i\xE7in
      yakla\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954373
    m_Localized: "Her at\u0131\u015Fta birka\xE7 mermi. Rakibi ni\u015Fang\xE2h\u0131n
      ortas\u0131nda tut."
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954374
    m_Localized: "H\u0131zl\u0131 s\xFCrekli ate\u015F. So\u011Fumak i\xE7in teti\u011Fi
      b\u0131rak."
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954375
    m_Localized: "G\xFC\xE7l\xFC ama yava\u015F at\u0131\u015Flar. At\u0131\u015F
      aralar\u0131nda dikkatle ni\u015Fan al."
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954376
    m_Localized: "Roket \xF6ndeki hedefi izler. G\xF6r\xFC\u015F hatt\u0131 a\xE7\u0131kken
      ate\u015F et."
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954377
    m_Localized: "Duvarlardan seker. Zor a\xE7\u0131lara ula\u015Fmak i\xE7in bariyerleri
      kullan."
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954378
    m_Localized: "Rakibi kendine \xE7eker. Menzilde kal ve s\xFCr\xFC\u015F \xE7izgine
      dikkat et."
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954379
    m_Localized: "\u015Earj\xF6r: {n} \xB7 doldurma: {seconds} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954380
    m_Localized: "\u015Earj\xF6r doldurma yok \xB7 \u0131s\u0131ya dikkat et"
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954381
    m_Localized: 'Menzil: {n} m'
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954382
    m_Localized: "Etki yar\u0131\xE7ap\u0131: {n} m"
    m_Metadata:
      m_Items: []
  - m_Id: 18182514304954383
    m_Localized: '{effect}: {seconds} sn'
    m_Metadata:
      m_Items: []
  - m_Id: 18240820457320448
    m_Localized: "Gaz: {bind.gas}. Geri: {bind.reverse}. D\xF6n\xFC\u015F: {bind.steer}.
      Fren: {bind.brake}. Piste d\xF6n: {bind.reset}."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097664
    m_Localized: "Ara\xE7 kendisi h\u0131zlan\u0131r. Oklarla d\xF6n. Yava\u015Flamak
      i\xE7in FREN tu\u015Funu bas\u0131l\u0131 tut. Geri d\xF6nmek i\xE7in \u201C{button}\u201D
      d\xFC\u011Fmesine dokun."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097665
    m_Localized: "Ate\u015F: {bind.fire} / sol fare. \u0130ki silah aras\u0131nda
      ge\xE7i\u015F: Q / fare tekerle\u011Fi veya {bind.one} ve {bind.two}."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097666
    m_Localized: "Ate\u015F: {bind.fire} / sol fare. Q bas\u0131l\u0131yken fareyi
      hareket ettirerek silah se\xE7; Q b\u0131rak\u0131nca ku\u015Fan. Q bas\u0131l\u0131yken
      Tab / tekerlek sayfay\u0131, {bind.slots} yuvay\u0131 se\xE7er."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097667
    m_Localized: "Ate\u015F etmek i\xE7in ATE\u015E bas\u0131l\u0131 tut. Ku\u015Fand\u0131\u011F\u0131n
      silahlar aras\u0131nda ge\xE7mek i\xE7in DE\u011E\u0130\u015ET\u0130R d\xFC\u011Fmesine
      dokun."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097668
    m_Localized: "{action}: {bind.secondary} / sa\u011F fare / LB. Cephane ve haz\u0131r
      olma durumu ekranda g\xF6sterilir."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097669
    m_Localized: "\u0130kincil silah\u0131 kullanmak i\xE7in {action} d\xFC\u011Fmesine
      dokun. Cephane ve haz\u0131r olma durumu ekranda g\xF6sterilir."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097670
    m_Localized: "Bir patlay\u0131c\u0131 yerle\u015Ftirildiyse patlatmak i\xE7in
      ayn\u0131 d\xFC\u011Fmeye yeniden bas."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820474097671
    m_Localized: "Gamepad: sol \xE7ubukla d\xF6n; RT / LT gaz / geri; A fren; Y piste
      d\xF6n\xFC\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820478291968
    m_Localized: "Gamepad: RB ate\u015F; y\xF6n tu\u015Fu a\u015Fa\u011F\u0131 /
      yukar\u0131 silah yuvas\u0131 1 / 2."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820478291969
    m_Localized: "Sadece may\u0131nlar. \xD6ne ge\xE7 ve arkana may\u0131n b\u0131rakmak
      i\xE7in {bind.secondary} / sa\u011F fareye bas."
    m_Metadata:
      m_Items: []
  - m_Id: 18240820478291970
    m_Localized: "Sadece may\u0131nlar. \xD6ne ge\xE7 ve takip\xE7ilere tuzak b\u0131rakmak
      i\xE7in MAYIN d\xFC\u011Fmesine dokun."
    m_Metadata:
      m_Items: []
  - m_Id: 18675088652316672
    m_Localized: "BU YARI\u015E: {n}/3 YILDIZ"
    m_Metadata:
      m_Items: []
  - m_Id: 18675088660705280
    m_Localized: "Bu yar\u0131\u015Fta kazan\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18675088660705281
    m_Localized: "\xD6nceden kazan\u0131ld\u0131 \xB7 korundu"
    m_Metadata:
      m_Items: []
  - m_Id: 18675088660705282
    m_Localized: "Bu yar\u0131\u015Fta kazan\u0131lmad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18826098154745856
    m_Localized: "Pist her tur de\u011Fi\u015Fir: 2. turda bariyerler kalkar, 3.
      turda yol daral\u0131r. Merkeze yak\u0131n kal."
    m_Metadata:
      m_Items: []
  - m_Id: 18826098205077504
    m_Localized: "H\u0131zlanmak i\xE7in parlayan halkalardan ge\xE7. Yolda bariyer
      yok: h\u0131zlanmadan \xF6nce arac\u0131 d\xFCzelt."
    m_Metadata:
      m_Items: []
  - m_Id: 18826098205077505
    m_Localized: "2. tur: bariyerler kalkt\u0131. Kenarlardan uzak dur!"
    m_Metadata:
      m_Items: []
  - m_Id: 18826098205077506
    m_Localized: "3. tur: yol darald\u0131. Merkezde kal!"
    m_Metadata:
      m_Items: []
  - m_Id: 18889347927715840
    m_Localized: HEMEN OYNA
    m_Metadata:
      m_Items: []
  - m_Id: 18889347952881664
    m_Localized: "KAR\u0130YER \xB7 K\u0130L\u0130TL\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 18889347952881665
    m_Localized: "A\xE7mak i\xE7in {name} yar\u0131\u015F\u0131nda ilk 3"
    m_Metadata:
      m_Items: []
  - m_Id: 18967065176387584
    m_Localized: Elendi
    m_Metadata:
      m_Items: []
  - m_Id: 18967065184776192
    m_Localized: 'Tur: {n}/{total}'
    m_Metadata:
      m_Items: []
  - m_Id: 18967758234791936
    m_Localized: "E\u011Fitim"
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180544
    m_Localized: "\u0130stedi\u011Fin dersi tekrarla. S\xFCre s\u0131n\u0131r\u0131
      veya \xF6d\xFCl yok; ilerlemen de\u011Fi\u015Fmez."
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180545
    m_Localized: "Drift h\u0131zlanmas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180546
    m_Localized: Kestirme
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180547
    m_Localized: "Tavan h\u0131zland\u0131r\u0131c\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180548
    m_Localized: Top isabeti
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180549
    m_Localized: "\xD6ndeki araca yeti\u015F ve topla vur. Hedef kar\u015F\u0131l\u0131k
      vermez."
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180550
    m_Localized: "Al\u0131\u015Ft\u0131rmay\u0131 ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180551
    m_Localized: "E\u011Fitime d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 18967758243180552
    m_Localized: "Al\u0131\u015Ft\u0131rma tamam! \xC7al\u0131\u015Fmaya devam et
      veya ba\u015Fka bir ders se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 18967758247374848
    m_Localized: "S\xFCr\xFC\u015F ipu\xE7lar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18967758247374849
    m_Localized: "Tekrar g\xF6ster"
    m_Metadata:
      m_Items: []
  - m_Id: 18967758247374850
    m_Localized: "\u0130pu\xE7lar\u0131 sonraki yar\u0131\u015Flarda tekrar g\xF6sterilecek."
    m_Metadata:
      m_Items: []
  - m_Id: 18971712024817664
    m_Localized: "Rekor ko\u015Fullar\u0131 bilinmiyor"
    m_Metadata:
      m_Items: []
  - m_Id: 18971712037400576
    m_Localized: "Motor {engine} \xB7 Z\u0131rh {armor} \xB7 Top {cannon}"
    m_Metadata:
      m_Items: []
  - m_Id: 18971712037400577
    m_Localized: "Devam kullan\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18971712037400578
    m_Localized: "Rekor farkl\u0131 ayarla yap\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 18971712037400579
    m_Localized: "\xD6nceki rekor ko\u015Fullar\u0131 bilinmiyor"
    m_Metadata:
      m_Items: []
  - m_Id: 18974832884789248
    m_Localized: "B\xFCy\xFCk dokunmatik d\xFC\u011Fmeler"
    m_Metadata:
      m_Items: []
  - m_Id: 18974832897372160
    m_Localized: "Sol el dokunmatik d\xFCzeni"
    m_Metadata:
      m_Items: []
  - m_Id: 18981564478468096
    m_Localized: "G\xFCncelleme gerekli"
    m_Metadata:
      m_Items: []
  - m_Id: 18981564486856704
    m_Localized: "Bu cihazda oyunun daha yeni s\xFCr\xFCm\xFCnden bir kay\u0131t
      var. \u0130lerlemeni koruyarak devam etmek i\xE7in oyunu g\xFCncelleyip yeniden
      a\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 18985758732136448
    m_Localized: Yenilgi
    m_Metadata:
      m_Items: []
  - m_Id: 19025653584441344
    m_Localized: +{n} kazan (reklam)
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829952
    m_Localized: "Reklam bonusu al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829953
    m_Localized: "\xD6d\xFCl ayr\u0131nt\u0131lar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829954
    m_Localized: "\xD6d\xFCl ayr\u0131nt\u0131lar\u0131n\u0131 gizle"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829955
    m_Localized: "Yar\u0131\u015F: {tier} \xB7 \xD7{n} uyguland\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829956
    m_Localized: "Biti\u015F s\u0131ras\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829957
    m_Localized: Tamamlanan turlar
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829958
    m_Localized: "G\xF6rev sonucu"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829959
    m_Localized: "\u0130mha bonuslar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829960
    m_Localized: "Taret puanlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653592829961
    m_Localized: "\u0130lk biti\u015F bonusu"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653597024256
    m_Localized: "Bug\xFCnk\xFC ilk biti\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 19025653597024257
    m_Localized: Reklam bonusu
    m_Metadata:
      m_Items: []
  - m_Id: 19025653597024258
    m_Localized: "Toplam al\u0131nan"
    m_Metadata:
      m_Items: []
  - m_Id: 19041856738635776
    m_Localized: "GAZ\nBA\u015ELA\u2019da!"
    m_Metadata:
      m_Items: []
  - m_Id: 19052585529192448
    m_Localized: "M\xFCkemmel ba\u015Flang\u0131\xE7: k\u0131sa bir h\u0131zlanma
      i\xE7in BA\u015ELA! an\u0131nda gaza bas. Gaz\u0131 \xF6nceden bas\u0131l\u0131
      tutmak veya otomatik gaz bonus kazand\u0131rmaz."
    m_Metadata:
      m_Items: []
  - m_Id: 19055832478330880
    m_Localized: "Kamera yak\u0131nla\u015Fma ve e\u011Fimi"
    m_Metadata:
      m_Items: []
  - m_Id: 19066674489929728
    m_Localized: "Dil y\xFCklenemedi. Ba\u011Flant\u0131n\u0131 kontrol edip tekrar
      se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 19075158564483072
    m_Localized: "\u0130lerleme bu cihazda kaydedilmedi"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871680
    m_Localized: "\u0130lerleme h\xE2l\xE2 bellekte. Yer a\xE7 veya taray\u0131c\u0131
      depolamas\u0131na izin ver, sonra tekrar dene. Oyunu kapatmak kaydedilmemi\u015F
      ilerlemeyi kaybettirebilir."
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871681
    m_Localized: Tekrar kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871682
    m_Localized: Kaydetmeden devam et
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871683
    m_Localized: "\u0130lerleme bu cihazda kaydedildi"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871684
    m_Localized: "Kay\u0131tl\u0131 ilerlemeye eri\u015Filemiyor"
    m_Metadata:
      m_Items: []
  - m_Id: 19075158572871685
    m_Localized: "Depolama okunamad\u0131. Kay\u0131tl\u0131 profilin de\u011Fi\u015Ftirilmedi.
      Taray\u0131c\u0131 depolamas\u0131na izin verip tekrar dene. Yeni de\u011Fi\u015Fiklikler
      \u015Fimdilik bellekte kal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 19951951802609664
    m_Localized: "\xC7\xF6l sava\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 19951951810998272
    m_Localized: "3 dakika / {n} rakip / en y\xFCksek puan kazan\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 19951951810998273
    m_Localized: "K\xF6pr\xFCde h\u0131zlan. Merkezin \xFCzerinden atlarken bomba
      b\u0131rakmak i\xE7in ate\u015Fe bas. Patlamadan \xF6nce k\u0131rm\u0131z\u0131
      \xE7emberden \xE7\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 19951951810998274
    m_Localized: "ATE\u015E \u2192 BOMBA BIRAK"
    m_Metadata:
      m_Items: []
  - m_Id: 19951951810998275
    m_Localized: "BOMBA BIRAKILDI \u2014 KIRMIZI \xC7EMBERDEN \xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 28159633885835264
    m_Localized: Yeni modeller
    m_Metadata:
      m_Items: []
  - m_Id: 28159633902612480
    m_Localized: Klasik modeller
    m_Metadata:
      m_Items: []
  - m_Id: 28262365795790848
    m_Localized: "S\u0131radaki yar\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 28262365808373760
    m_Localized: "A\xE7\u0131lan yar\u0131\u015Flar: {n}/{max}"
    m_Metadata:
      m_Items: []
  - m_Id: 28262365812568064
    m_Localized: Dil ve ses
    m_Metadata:
      m_Items: []
  - m_Id: 28262365812568065
    m_Localized: Kontroller
    m_Metadata:
      m_Items: []
  - m_Id: 28262365812568066
    m_Localized: "G\xF6r\xFCnt\xFC ve kamera"
    m_Metadata:
      m_Items: []
  - m_Id: 28262726132641792
    m_Localized: "Piste d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224704
    m_Localized: "Tak\u0131ld\u0131n m\u0131? \u201C{button}\u201D d\xFC\u011Fmesine
      dokun"
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224705
    m_Localized: "\u2605 {n}/3"
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224706
    m_Localized: "Hayaletine g\xF6re sekt\xF6rler \xB7 \u2212 daha h\u0131zl\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224707
    m_Localized: "K\xF6pr\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224708
    m_Localized: Kule
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224709
    m_Localized: Pit
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224710
    m_Localized: "Sekt\xF6r {n}"
    m_Metadata:
      m_Items: []
  - m_Id: 28262726145224711
    m_Localized: '{t} sn'
    m_Metadata:
      m_Items: []
  - m_Id: 28923211244974080
    m_Localized: "\u0130lerleme yerel yedekten geri y\xFCklendi."
    m_Metadata:
      m_Items: []
  - m_Id: 28923211253362688
    m_Localized: "Yerel kay\u0131t hasarl\u0131. \u0130lerleme buluttan geri y\xFCklendi."
    m_Metadata:
      m_Items: []
  - m_Id: 28923211253362689
    m_Localized: "Kullan\u0131labilir yerel yedek yok. Hasarl\u0131 kay\u0131t ayr\u0131
      tutuldu."
    m_Metadata:
      m_Items: []
  - m_Id: 28966960855592960
    m_Localized: Son Sefer
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175872
    m_Localized: "Kupay\u0131 geri al \xB7 1 muhaf\u0131z arac\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175873
    m_Localized: "Kupay\u0131 geri al"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175874
    m_Localized: "Muhaf\u0131z arac\u0131n\u0131 saf d\u0131\u015F\u0131 b\u0131rak"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175875
    m_Localized: "Tren muhaf\u0131z\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175876
    m_Localized: "Kupa son vagonda. Sol yol treni izler, sa\u011F yol makasa kestirmedir."
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175877
    m_Localized: "Muhaf\u0131z arac\u0131n\u0131 ge\xE7 ya da yoldan it."
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175878
    m_Localized: "Son vagona yeti\u015F ve h\u0131z\u0131n\u0131 ona uydur."
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175879
    m_Localized: "Vagonun yan\u0131nda kal \xB7 %{n}"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175880
    m_Localized: "Makas \xE7evrildi. Treni istasyona kadar izle."
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175881
    m_Localized: "Kupay\u0131 almak i\xE7in son vagonun yan\u0131na s\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175882
    m_Localized: "Kayalar\u0131n ard\u0131ndan tren d\xFCd\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175883
    m_Localized: "Kupa hareket h\xE2lindeki trenden al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175884
    m_Localized: "Kupa istasyonda al\u0131nd\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175885
    m_Localized: "Tren kupayla s\u0131n\u0131r\u0131 ge\xE7ti"
    m_Metadata:
      m_Items: []
  - m_Id: 28966960868175886
    m_Localized: "Muhaf\u0131z\u0131 ge\xE7 ve {s} saniye son vagonun yan\u0131nda
      kal. Ya da kuru dere yata\u011F\u0131ndan kestir, makasa trenden \xF6nce var
      ve kupay\u0131 istasyonda al."
    m_Metadata:
      m_Items: []
  - m_Id: 29276668464279552
    m_Localized: "Rakipler \xB7 temel at\u0131\u015F aral\u0131\u011F\u0131 {s} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 29276668472668160
    m_Localized: "M\xFCttefikler \xB7 temel at\u0131\u015F aral\u0131\u011F\u0131
      {s} sn"
    m_Metadata:
      m_Items: []
  - m_Id: 29276668472668161
    m_Localized: "Muhaf\u0131z \xB7 temel at\u0131\u015F aral\u0131\u011F\u0131 {s}
      sn"
    m_Metadata:
      m_Items: []
  - m_Id: 29276668472668162
    m_Localized: "Toplar devre d\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29276668472668163
    m_Localized: "Yar\u0131\u015F \xF6d\xFCl\xFC \xD7{m}"
    m_Metadata:
      m_Items: []
  - m_Id: 29278481313771520
    m_Localized: '{n}/{target}'
    m_Metadata:
      m_Items: []
  - m_Id: 29278481322160128
    m_Localized: "Hedefe kalan s\u0131ra \xB7 {n}"
    m_Metadata:
      m_Items: []
  - m_Id: 29278481322160129
    m_Localized: Gecikme +{t} sn
    m_Metadata:
      m_Items: []
  - m_Id: 29278481322160130
    m_Localized: "Ara\xE7 kayb\u0131 \xB7 {n}"
    m_Metadata:
      m_Items: []
  - m_Id: 29278481322160131
    m_Localized: "Kay\u0131p {wrecks} \xB7 s\u0131f\u0131rlama {resets}"
    m_Metadata:
      m_Items: []
  - m_Id: 29278481322160132
    m_Localized: "S\u0131ra {p} \xB7 onar\u0131m {repairs}"
    m_Metadata:
      m_Items: []
  - m_Id: 29279795364048896
    m_Localized: "Yar\u0131\u015F sonu\xE7lar\u0131na d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 29279795376631808
    m_Localized: "Antrenman \xB7 {lesson}"
    m_Metadata:
      m_Items: []
  - m_Id: 29706000609390592
    m_Localized: "Kalk\u0131\u015F zamanlamas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29706000626167808
    m_Localized: "Ba\u015Flang\u0131\xE7 i\u015Faretinde gaza bas. Eksi erken, art\u0131
      ge\xE7 bast\u0131\u011F\u0131n\u0131 g\xF6sterir. Yeniden ba\u015Flamak i\xE7in
      Tekrar'a bas."
    m_Metadata:
      m_Items: []
  - m_Id: 29706000626167809
    m_Localized: "{ms} ms \xB7 H\u0131zlanma kazan\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29706000626167810
    m_Localized: "{ms} ms \xB7 H\u0131zlanma yok"
    m_Metadata:
      m_Items: []
  - m_Id: 29707364823543808
    m_Localized: "{name} yar\u0131\u015F\u0131nda ilk 3 veya {n} \u2605 daha"
    m_Metadata:
      m_Items: []
  - m_Id: 29710175632175104
    m_Localized: "Bir rakibe yeti\u015F ve ni\u015Fang\xE2h yand\u0131\u011F\u0131nda
      ate\u015F et."
    m_Metadata:
      m_Items: []
  - m_Id: 29710175678312448
    m_Localized: "Viraja drift yaparak gir ve h\u0131zlanmak i\xE7in freni b\u0131rak."
    m_Metadata:
      m_Items: []
  - m_Id: 29710175678312449
    m_Localized: "Y\u0131k\u0131k k\xF6pr\xFCden \xF6nce h\u0131zlan ve bo\u015Flu\u011Fu
      a\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 29710175678312450
    m_Localized: Harita
    m_Metadata:
      m_Items: []
  - m_Id: 29710175678312451
    m_Localized: HAVA AKIMI
    m_Metadata:
      m_Items: []
  - m_Id: 29710175678312452
    m_Localized: "En iyi sekt\xF6rlerden antrenman turu \xB7 {t}"
    m_Metadata:
      m_Items: []
  - m_Id: 29712712435314688
    m_Localized: Manga hedefi
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091904
    m_Localized: "K\u0131\xE7 \xE7ekirde\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091905
    m_Localized: Havan
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091906
    m_Localized: "Dron hangar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091907
    m_Localized: Ana top
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091908
    m_Localized: "U\xE7aksavar"
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091909
    m_Localized: "Zamana kar\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091910
    m_Localized: "Kendi zaman\u0131n\u0131 geli\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091911
    m_Localized: "Kayd\u0131 izle"
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091912
    m_Localized: Duraklat
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091913
    m_Localized: "Bu kay\u0131t farkl\u0131 bir pist d\xFCzenini kullan\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 29712712452091914
    m_Localized: "Kompakt yar\u0131\u015F aray\xFCz\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 29714648865779712
    m_Localized: "Hangar dron f\u0131rlat\u0131r. Havan sald\u0131r\u0131dan \xF6nce
      yeri i\u015Faretler."
    m_Metadata:
      m_Items: []
  - m_Id: 29714648886751232
    m_Localized: "\xC7ekirdek hasar\u0131n {d}  \xB7  Y\u0131kt\u0131\u011F\u0131n
      istasyon {s}  \xB7  Kurtard\u0131\u011F\u0131n m\xFCttefik {a}"
    m_Metadata:
      m_Items: []
  - m_Id: 29714648886751233
    m_Localized: "B\xFCy\xFCk yaz\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29714648886751234
    m_Localized: "Son be\u015F bitiri\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 29718720071151616
    m_Localized: "\xC7at\u0131\u015Fma parlamalar\u0131n\u0131 azalt"
    m_Metadata:
      m_Items: []
  - m_Id: 29718720087928832
    m_Localized: "Standart ara\xE7 ve silahlar \xB7 Normal"
    m_Metadata:
      m_Items: []
  - m_Id: 29718720087928833
    m_Localized: Kamera mesafesi
    m_Metadata:
      m_Items: []
  - m_Id: 29718720087928834
    m_Localized: "D\xFCn\xFCn g\xFCnl\xFCk yar\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29718720087928835
    m_Localized: "D\xFCnk\xFC pistte ve kurallarla antrenman yap. G\xFCnl\xFCk serin
      ve s\u0131ralama puan\u0131n korunur."
    m_Metadata:
      m_Items: []
  - m_Id: 29718720087928836
    m_Localized: "Son antrenman biti\u015Fi \xB7 {t}"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473942106112
    m_Localized: Su konvoyu
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077632
    m_Localized: "Tankeri Son Kuyu\u2019ya g\xF6t\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077633
    m_Localized: "Su yerle\u015Fime ula\u015Ft\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077634
    m_Localized: Tanker yok edildi
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077635
    m_Localized: "Tanker %{h}   \xB7   Kuyu {m} m"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077636
    m_Localized: "Pusu! Tanker %{h}   \xB7   {m} m"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077637
    m_Localized: Arkaya bak
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077638
    m_Localized: "Direksiyonu \xE7evirirken arkaya bakmak i\xE7in {button} tu\u015Funu
      bas\u0131l\u0131 tut."
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077639
    m_Localized: '{n} puan'
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077640
    m_Localized: "Co\u015Fku \xD7{n}"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077641
    m_Localized: Drift takviyesi
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077642
    m_Localized: "\u0130sabet ettir"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077643
    m_Localized: "70 km/sa ile \xE7arp"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077644
    m_Localized: Seri tamam
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077645
    m_Localized: "H\u0131z d\xFC\u015Ft\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077646
    m_Localized: "Liderli\u011Fi payla\u015F\u0131yorsun"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077647
    m_Localized: "{n} puanla \xF6ndesin"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077648
    m_Localized: "Lider {name} \xB7 fark {n} puan"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077649
    m_Localized: "H\u0131z {s} \xB7 isabet {h} \xB7 imha {k} \xB7 merkez {c} \xB7
      ya\u015Fam {l}"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077650
    m_Localized: Asist {n}
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077651
    m_Localized: "Puan, sonra imha ve daha az \xF6l\xFCm. E\u015Fitler s\u0131ray\u0131
      payla\u015F\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077652
    m_Localized: "Yak\u0131n rakip bul"
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077653
    m_Localized: "Uygun rakip yok. Yine de yar\u0131\u015Fabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 29721473963077654
    m_Localized: "Rakip {t} \xB7 S\xFCrene g\xF6re fark {d}"
    m_Metadata:
      m_Items: []
  - m_Id: 29723557332594688
    m_Localized: "Hedefe yaln\u0131zca ak\u0131nc\u0131lar hasar verebilir"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860491366400
    m_Localized: "Dokunmatik d\xFC\u011Fme konumlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337920
    m_Localized: "D\xFC\u011Fmeleri ta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337921
    m_Localized: "D\xFC\u011Fmeleri parmaklar\u0131n\u0131n rahat\xE7a ula\u015Faca\u011F\u0131
      yere s\xFCr\xFCkle."
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337922
    m_Localized: "Konumlar\u0131 s\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337923
    m_Localized: "W/yukar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337924
    m_Localized: "S/a\u015Fa\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337925
    m_Localized: A/D veya oklar
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337926
    m_Localized: "Bo\u015Fluk"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337927
    m_Localized: Ctrl
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337928
    m_Localized: E / Shift
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337929
    m_Localized: R
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337930
    m_Localized: 1
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337931
    m_Localized: 2
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337932
    m_Localized: "1\u20130"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337933
    m_Localized: V
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337934
    m_Localized: Klavye kontrolleri
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337935
    m_Localized: Gaz
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337936
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337937
    m_Localized: "Sola d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337938
    m_Localized: "Sa\u011Fa d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337939
    m_Localized: "\u0130kincil silah"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337940
    m_Localized: "Silah se\xE7imi"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860512337941
    m_Localized: "Silah yuvas\u0131 {n}"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532224
    m_Localized: "{action} i\xE7in bir tu\u015Fa bas."
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532225
    m_Localized: "{button}, {action} i\xE7in kullan\u0131l\u0131yor. Ba\u015Fka tu\u015F
      se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532226
    m_Localized: "\u0130ptal"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532227
    m_Localized: "Varsay\u0131lan tu\u015Flara d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532228
    m_Localized: "\xC7ubuk \xF6l\xFC b\xF6lgesi"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532229
    m_Localized: "\xC7ubuk hassasiyeti"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532230
    m_Localized: Direksiyon tepkisi
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532231
    m_Localized: "S\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532232
    m_Localized: "Arkada\u015F meydan okuma kodu"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532233
    m_Localized: Kodumu al
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532234
    m_Localized: "Kodla yar\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532235
    m_Localized: "Kod ge\xE7ersiz veya eksik."
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532236
    m_Localized: "Bu kod s\xFCr\xFCm\xFC desteklenmiyor."
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532237
    m_Localized: "Bu pist veya gerekli donan\u0131m kullan\u0131lam\u0131yor."
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532238
    m_Localized: "Hedef s\xFCre \xB7 {t}"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532239
    m_Localized: "Haftan\u0131n hedefleri"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532240
    m_Localized: "Bir pist yar\u0131\u015F\u0131n\u0131 bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532241
    m_Localized: "Pist yar\u0131\u015F\u0131n\u0131 ilk \xFC\xE7te bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532242
    m_Localized: "Bir arena sava\u015F\u0131n\u0131 bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532243
    m_Localized: "Arena sava\u015F\u0131n\u0131 bir elemeyle bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532244
    m_Localized: "Bir g\xF6revi tamamla"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532245
    m_Localized: "Bir g\xF6revi enkaza d\xF6nmeden bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532246
    m_Localized: "\xDC\xE7 hedefin \xF6d\xFCl\xFC \xB7 {name}"
    m_Metadata:
      m_Items: []
  - m_Id: 29727860516532247
    m_Localized: '{name}  {s} sn'
    m_Metadata:
      m_Items: []
  - m_Id: 29732681093033984
    m_Localized: "Darbe geliyor! Kayan\u0131n arkas\u0131na ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754240
    m_Localized: "Hava sald\u0131r\u0131s\u0131! \xC7izgili \u015Feritten \xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754241
    m_Localized: "\xC7at\u0131 \xE7\xF6k\xFCyor! D\u0131\u015Far\u0131 \xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754242
    m_Localized: "Son Kuyu savunmas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754243
    m_Localized: "Kuyu y\u0131k\u0131lmadan iki dalgay\u0131 p\xFCsk\xFCrt"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754244
    m_Localized: "\u0130ki dalga p\xFCsk\xFCrt\xFCld\xFC. Kuyu g\xFCvende."
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754245
    m_Localized: "Kuyu y\u0131k\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754246
    m_Localized: "1. dalga bat\u0131dan   \xB7   Kuyu %{h}"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754247
    m_Localized: "2. dalga do\u011Fudan   \xB7   Kuyu %{h}"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754248
    m_Localized: "Buggy \xB7 K\u0131sayoldan ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754249
    m_Localized: "Spor \xB7 Drift takviyesi kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754250
    m_Localized: "Z\u0131rhl\u0131 \xB7 Rakip ele"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754251
    m_Localized: "Tank \xB7 S\u0131cak bombay\u0131 aktar"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754252
    m_Localized: "Ustal\u0131k rozeti kazan\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754253
    m_Localized: "S\xFCr\xFCc\xFC profili"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754254
    m_Localized: "En \xE7ok fini\u015F yap\u0131lan kasa"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754255
    m_Localized: "Kazan\u0131lan kupa"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754256
    m_Localized: "En yak\u0131n fini\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754257
    m_Localized: "Hen\xFCz kay\u0131tl\u0131 sonu\xE7 yok"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754258
    m_Localized: "Kay\u0131tl\u0131 donan\u0131mlar"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754259
    m_Localized: "Donan\u0131ma ad ver"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754260
    m_Localized: "Mevcut donan\u0131m\u0131 kaydet"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754261
    m_Localized: "Silahlar\u0131 kar\u015F\u0131la\u015Ft\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754262
    m_Localized: "At\u0131\u015F \u0131s\u0131s\u0131 {shot} \xB7 so\u011Fuma {cool}/sn"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754263
    m_Localized: Silah talimleri
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754264
    m_Localized: "Hareketli arac\u0131 topla vur"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754265
    m_Localized: "Kalkan\u0131 \u0131\u015F\u0131nla k\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754266
    m_Localized: "Takip\xE7iyi may\u0131nla yakala"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754267
    m_Localized: Talimi tekrarla
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754268
    m_Localized: Favoriler
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754269
    m_Localized: Favorilere ekle
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754270
    m_Localized: "Favoriden \xE7\u0131kar"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754271
    m_Localized: "{name} i\xE7in biriktir"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754272
    m_Localized: "{name} hedefini kald\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754273
    m_Localized: "{name} i\xE7in {n} jeton kald\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754274
    m_Localized: "Art\u0131k {name} alabilirsin"
    m_Metadata:
      m_Items: []
  - m_Id: 29732681151754275
    m_Localized: '{n} sn'
    m_Metadata:
      m_Items: []
  - m_Id: 29745034027151360
    m_Localized: Son isabetler
    m_Metadata:
      m_Items: []
  - m_Id: 29745034048122880
    m_Localized: Son darbe
    m_Metadata:
      m_Items: []
  - m_Id: 29745034048122881
    m_Localized: "D\xFC\u015Fman"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034048122882
    m_Localized: Eleme pisti
    m_Metadata:
      m_Items: []
  - m_Id: 29745034048122883
    m_Localized: "Lider her turu bitirdi\u011Finde sonuncu elenir. Ayn\u0131 anda
      ge\xE7i\u015Fte k\xFC\xE7\xFCk start numaras\u0131 kal\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034048122884
    m_Localized: "Elendi \xB7 {name}"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317184
    m_Localized: "Bir yar\u0131\u015F\u0131 buggy ile kestirmeden gidip bitir ve
      Sidewinder kazan."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317185
    m_Localized: "Z\u0131rhl\u0131 ara\xE7la bir rakibe \xE7arp\u0131p yar\u0131\u015F\u0131
      bitir ve Raider kazan."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317186
    m_Localized: "G\xF6rev tamam \xB7 {name} a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317187
    m_Localized: "H\u0131zlanma, fren ve slalomu \xF6l\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317188
    m_Localized: "Otomatik test \xB7 0\u201345 km/sa ve tam fren"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317189
    m_Localized: "Kap\u0131lar\u0131n aras\u0131ndan ge\xE7 \xB7 {n}/{all}"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317190
    m_Localized: "Kap\u0131 ka\xE7t\u0131 \xB7 testi yinele"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317191
    m_Localized: "\xD6l\xE7\xFCm garaja kaydedildi"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317192
    m_Localized: "0\u201345 {acc} \xB7 fren {m} m \xB7 slalom {slalom}"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317193
    m_Localized: "Turuncu ara\xE7taki {name} ile tan\u0131\u015F."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317194
    m_Localized: "B\xFCy\xFCk finalde r\xF6van\u015F \xB7 {name} geri d\xF6nd\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317195
    m_Localized: "Rakip \xB7 {name}"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317196
    m_Localized: "{name} \xF6n\xFCnde bitirdin"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317197
    m_Localized: "{name} \xF6n\xFCnde bitirdi"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317198
    m_Localized: "{name} ile d\xFCello \xB7 ikiniz de bitirmelisiniz"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317199
    m_Localized: "Sen #{you} \xB7 {name} #{rival}"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317200
    m_Localized: Kanyon rakipleri
    m_Metadata:
      m_Items: []
  - m_Id: 29745034052317201
    m_Localized: "\u0130ki kez podyuma \xE7\u0131k, ard\u0131ndan Rex\u2019i ge\xE7.
      \xD6d\xFCl \xB7 {reward}"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511488
    m_Localized: "Girmek i\xE7in 6. etab\u0131 a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511489
    m_Localized: "Kar\u015F\u0131la\u015Fmalar \xB7 galibiyet {wins} / yenilgi {losses}"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511490
    m_Localized: "Ka\xE7\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511491
    m_Localized: "Biti\u015Fe ka\xE7. Takip\xE7i 0,6 sn boyunca 7 m yak\u0131n\u0131nda
      kal\u0131rsa yakalan\u0131rs\u0131n. K\xF6pr\xFC kestirmedir."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511492
    m_Localized: "Ka\xE7may\u0131 ba\u015Fard\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511493
    m_Localized: "Yakaland\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511494
    m_Localized: "\u0130ki ara\xE7l\u0131 bayrak yar\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511495
    m_Localized: "\u0130ki ara\xE7 se\xE7. Turun ortas\u0131ndaki ye\u015Fil kemerde
      ara\xE7 de\u011Fi\u015Ftir. Dune buggy \xF6d\xFCn\xE7 verilir."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511496
    m_Localized: "\u0130lk etap"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511497
    m_Localized: "\u0130kinci etap"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511498
    m_Localized: "\xD6zel yar\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511499
    m_Localized: Pist
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511500
    m_Localized: Kural
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511501
    m_Localized: Normal kurallar
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511502
    m_Localized: "S\u0131cak Bomba i\xE7in en az bir rakip ekle veya ba\u015Fka kural
      se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511503
    m_Localized: "A\xE7\u0131k bir pist ve listedeki kurallardan birini se\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 29745034056511504
    m_Localized: "Bu \xF6zel yar\u0131\u015F\u0131n ayr\u0131 s\u0131ralamas\u0131
      var. Kariyer rekorlar\u0131 ve \xF6d\xFClleri kariyer etkinliklerinde."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733624250368
    m_Localized: "Ta\u015F oca\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733636833280
    m_Localized: "Kahverengi toprak kestirme buggy i\xE7in uygundur. Asfalt yolla
      virajdan sonra birle\u015Fir."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733636833281
    m_Localized: "Arkada\u015Flarla oyna"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733636833282
    m_Localized: "\xD6zel yar\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733636833283
    m_Localized: "Leviathan\u2019a kar\u015F\u0131 birlikte"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027584
    m_Localized: "Arkada\u015F\u0131n\u0131n oda kodu"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027585
    m_Localized: "Odaya kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027586
    m_Localized: "Oyuncular {n}/4 \xB7 Davet kodu"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027587
    m_Localized: "Bir s\xFCr\xFCc\xFC ayr\u0131ld\u0131. Ma\xE7 sona erdi."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027588
    m_Localized: "Oda kullan\u0131lam\u0131yor. Kodu kontrol edip yeniden dene."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027589
    m_Localized: "S\xFCr\xFCc\xFC {n}"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027590
    m_Localized: Bot {n}
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027591
    m_Localized: "\xC7at\u0131lar Aras\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027592
    m_Localized: "\xC7at\u0131da h\u0131zlan. Sar\u0131 ini\u015F alan\u0131n\u0131
      hedefle veya alt yoldan git."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027593
    m_Localized: Sabit tempo
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027594
    m_Localized: "Rakipler aran\u0131zdaki mesafe de\u011Fi\u015Fse de se\xE7ti\u011Fin
      zorlu\u011Fun temposunu korur."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027595
    m_Localized: Buz istasyonu
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027596
    m_Localized: "A\xE7\u0131k mavi viraj buzludur. Kapal\u0131 yol daha iyi tutunur."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027597
    m_Localized: "Yanarda\u011F ge\xE7idi"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027598
    m_Localized: "\u0130lk tur ana yoldan gider. Uyar\u0131dan sonra ikinci turdaki
      kestirme a\xE7\u0131l\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027599
    m_Localized: "Ana yol a\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027600
    m_Localized: Sonraki turda kestirmeden git
    m_Metadata:
      m_Items: []
  - m_Id: 29752733641027601
    m_Localized: "Kestirme a\xE7\u0131k"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
