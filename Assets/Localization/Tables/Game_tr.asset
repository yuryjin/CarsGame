    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456577
    m_Localized: Yok
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456578
    m_Localized: Topu kullan
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456579
    m_Localized: "Donan\u0131m: {primary} / {secondary}"
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456580
    m_Localized: "Yaln\u0131zca sat\u0131n al\u0131nan silahlar kullan\u0131l\u0131r.
      De\u011Fi\u015Fim \xFCcretsizdir."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456581
    m_Localized: "Standart de\u011Ferler. Top; ikincil silah yok."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456582
    m_Localized: "H\u0131z +%10, ivme +%8; can -%15, yol tutu\u015F -%5. Top + dondurucu."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456583
    m_Localized: "Can +%30; h\u0131z -%6, ivme -%10. Top + may\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456584
    m_Localized: "Ana silah hasar\u0131 +%20, at\u0131\u015F aral\u0131\u011F\u0131
      -%10; can -%10, h\u0131z -%3. MT + may\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456585
    m_Localized: "\u0130lk {n} i\xE7inde bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456586
    m_Localized: '{n} rakibi yok et'
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456587
    m_Localized: "Onar\u0131m yapmadan kazan"
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456588
    m_Localized: "{t} i\xE7inde bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 7658824722456589
    m_Localized: "Yar\u0131\u015F\u0131 bitir"
    m_Metadata:
      m_Items: []
